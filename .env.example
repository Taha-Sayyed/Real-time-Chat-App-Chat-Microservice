PORT = 5002

MONGO_URI=paste MONGO_URI

# RSA public key from the User microservice
# Can be in either format:
# 1. PEM format (with headers): "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# 2. Base64-encoded DER (without headers): raw base64 string (will be auto-converted to PEM)
JWT_PUBLIC_KEY=<paste RSA public key from User service>

USER_SERVICE = http://localhost:5000

Cloud_Name = your_cloud_naeme

Api_Key = your_api_key

Api_Secret = your_secret_api_key